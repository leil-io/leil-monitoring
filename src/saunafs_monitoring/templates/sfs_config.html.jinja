<!-- Exports Table -->
{% if exports %}
<table class="FR sortable" cellspacing="0" caption="Exports">
        <thead>
                <tr><th colspan="5">Exports</th></tr>
                <tr>
                        <th>#</th>
                        <th>IP From</th>
                        <th>IP To</th>
                        <th>Path</th>
                        <th>Flags</th>
                </tr>
        </thead>
        <tbody>
                {% for export in exports %}
                <tr class="C{{ loop.index % 2 + 1 }}">
                        <td align="right">{{ export.id }}</td>
                        <td align="center">{{ export.ip_from }}</td>
                        <td align="center">{{ export.ip_to }}</td>
                        <td align="left">{{ export.path }}</td>
                        <td align="left">{{ export.flags }}</td>
                </tr>
                {% endfor %}
        </tbody>
</table>
{% endif %}

<!-- Goals table -->
{% if goals %}
<table class="FR" cellspacing="3" caption="Goals">
        <thead>
                <tr><th colspan="3">Goals</th></tr>
                <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Definition</th>
                </tr>
        </thead>
        <tbody>
                {% for goal in goals %}
                <tr class="C{{ loop.index % 2 + 1 }}">
                        <td align="center">{{goal.id}}</td>
                        <td align="center">{{ goal.name }}</td>
                        <td align="left">{{ goal.definition }}</td>
                </tr>
                {% endfor %}
        </tbody>
</table>
{% endif %}
