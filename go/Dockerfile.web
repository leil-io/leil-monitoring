# 1) Build the Preact SPA. Vite writes to ../internal/webui/dist.
FROM node:20-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json* ./
RUN npm ci || npm install
COPY web/ ./
RUN npm run build

# 2) Build the Go web server with the SPA embedded.
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/internal/webui/dist ./internal/webui/dist
RUN CGO_ENABLED=0 go build -trimpath -o /leil-monitoring ./cmd/leil-monitoring

FROM gcr.io/distroless/static-debian12
COPY --from=build /leil-monitoring /leil-monitoring
EXPOSE 8000
ENTRYPOINT ["/leil-monitoring"]
