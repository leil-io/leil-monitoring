{% if chunk_matrix %}
<table class="FR" cellspacing="0" caption="Chunks state matrix">
	<tr><th colspan="13">All chunks state matrix </th></tr>
	<tr>
		<th rowspan="2" class="PERC4">needed<br/>copies</th>
		<th colspan="12" class="PERC96">Valid copies (standard goal chunks only)</th>
	</tr>
	<tr>
	{% for i in range(11) %}
		<th class="PERC8">{{ i if i < 10 else "10+" }}</th>
	{% endfor %}
		<th class="PERC8">all</th>
	</tr>
	{% for i in range(11) %}
	<tr>
		<td align="center">{{ i if i < 10 else "10+" }}</td>
		{% for j in range(11) %}
			{% set value = chunk_matrix.matrix[i][j] %}
			{% if i == 0 %}
				{% if j == 0 %}
				{% set class = "DELETEREADY" %}
				{% else %}
				{% set class = "DELETEPENDING" %}
				{% endif %}
			{% elif j == 0 %}
				{% set class = "MISSING" %}
			{% elif j > i %}
				{% set class = "OVERGOAL" %}
			{% elif j < i %}
				{% if j == 1 %}
					{% set class = "ENDANGERED" %}
				{% else %}
					{% set class = "UNDERGOAL" %}
				{% endif %}
			{% else %}
				{% set class = "NORMAL" %}
			{% endif %}
			<td align="right">
				<span class="{{ class }}">
					{{ value if value > 0 else "-" }}
				</span>
			</td>
		{% endfor %}
		<td align="right">{{ chunk_matrix.matrix[i] | sum }}</td>
	</tr>
	{% endfor %}
	<tr>
		<td colspan="13">
			<ul class="status-summary" aria-label="Record status summary">
				<li>
					<span class="status-dot status-missing" aria-hidden="true"></span>
					<span class="status-label">Missing</span>
					<span class="status-count" data-status="missing">0</span>
				</li>
				<li>
					<span class="status-dot status-endangered" aria-hidden="true"></span>
					<span class="status-label">Endangered</span>
					<span class="status-count" data-status="endangered">0</span>
				</li>
				<li>
					<span class="status-dot status-undergoal" aria-hidden="true"></span>
					<span class="status-label">Undergoal</span>
					<span class="status-count" data-status="undergoal">0</span>
				</li>
				<li>
					<span class="status-dot status-stable" aria-hidden="true"></span>
					<span class="status-label">Stable</span>
					<span class="status-count" data-status="stable">217630</span>
				</li>
				<li>
					<span class="status-dot status-overgoal" aria-hidden="true"></span>
					<span class="status-label">Overgoal</span>
					<span class="status-count" data-status="overgoal">0</span>
				</li>
				<li>
					<span class="status-dot status-pending-delete" aria-hidden="true"></span>
					<span class="status-label">Pending deletion</span>
					<span class="status-count" data-status="pending-delete">0</span>
				</li>
				<li>
					<span class="status-dot status-ready-remove" aria-hidden="true"></span>
					<span class="status-label">Ready to be removed</span>
					<span class="status-count" data-status="ready-remove">8</span>
				</li>
			</ul>
		</td>
	</tr>
</table>
{% endif %}

{% if fs_check_info and fs_check_info.loop_start > 0 %}
<table class="FR" cellspacing="0" caption="Filesystem Check Info">
	<tr><th colspan="8">Filesystem Check Info</th></tr>
	<tr>
		<th>Check Loop Start Time</th>
		<th>Check Loop End Time</th>
		<th>Files</th>
		<th>Under-Goal Files</th>
		<th>Missing Files</th>
		<th>Chunks</th>
		<th>Under-Goal Chunks</th>
		<th>Missing Chunks</th>
	</tr>
	<tr>
		<td align="center">{{ fs_check_info.loop_start | format_timestamp }}</td>
		<td align="center">{{ fs_check_info.loop_end | format_timestamp }}</td>
		<td align="right">{{ fs_check_info.files }}</td>
		<td align="right">{{ fs_check_info.under_goal_files }}</td>
		<td align="right">{{ fs_check_info.missing_files }}</td>
		<td align="right">{{ fs_check_info.chunks }}</td>
		<td align="right">{{ fs_check_info.under_goal_chunks }}</td>
		<td align="right">{{ fs_check_info.missing_chunks }}</td>
	</tr>
	{% if fs_check_info.message %}
	<tr>
		<th colspan="8">Important Messages</th>
	</tr>
	<tr>
		<td colspan="8" align="left"><pre>{{ fs_check_info.message }}</pre></td>
	</tr>
	{% endif %}
</table>
{% endif %}
